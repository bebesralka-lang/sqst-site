/* ============================================================
   SQST — Общие стили
   ============================================================ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --gold: #c9a96e;
    --gold-light: #e8d5a3;
    --gold-dark: #b8954a;
    --pink: #e182c3;
    --bg: #1a1818;
    --card: #25252b;
    --text: #f0ece6;
    --text-muted: #a09888;
    --border: rgba(201, 169, 110, 0.08);
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.6;
}

/* ===== НАВИГАЦИЯ ===== */
.navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(26, 24, 24, 0.9);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    padding: 16px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
}

.navbar .logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    letter-spacing: 4px;
    color: var(--text);
}

.navbar .logo .gold {
    color: var(--gold);
}

.navbar .nav-links {
    display: flex;
    gap: 24px;
    list-style: none;
    flex-wrap: wrap;
}

.navbar .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: 0.3s;
    border-bottom: 2px solid transparent;
    padding-bottom: 4px;
}

.navbar .nav-links a:hover,
.navbar .nav-links a.active {
    color: var(--gold);
    border-bottom-color: var(--gold);
}

/* ===== КОНТЕЙНЕР ===== */
.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 24px;
}

/* ===== ЗАГОЛОВКИ ===== */
h1 {
    font-family: 'Playfair Display', serif;
    font-size: 3rem;
    color: var(--text);
    margin-bottom: 16px;
    letter-spacing: 1px;
}

h1 .gold {
    color: var(--gold);
}

h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: var(--gold);
    margin-bottom: 24px;
    letter-spacing: 1px;
}

h3 {
    font-size: 1.2rem;
    color: var(--text);
    margin-bottom: 12px;
}

p {
    color: var(--text-muted);
    margin-bottom: 16px;
    line-height: 1.8;
}

/* ===== КНОПКИ ===== */
.btn {
    display: inline-block;
    padding: 12px 32px;
    background: linear-gradient(135deg, var(--gold), var(--gold-dark));
    color: #1a1818;
    border-radius: 60px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: 0.3s;
    box-shadow: 0 4px 20px rgba(201, 169, 110, 0.15);
    border: none;
    cursor: pointer;
}

.btn:hover {
    background: linear-gradient(135deg, var(--gold-light), var(--gold));
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(201, 169, 110, 0.25);
}

.btn-outline {
    background: transparent;
    border: 1.5px solid var(--border);
    color: var(--text);
    box-shadow: none;
}

.btn-outline:hover {
    background: rgba(201, 169, 110, 0.06);
    border-color: var(--gold);
}

/* ===== КАРТОЧКИ ===== */
.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 30px;
}

.card {
    background: var(--card);
    border-radius: 20px;
    padding: 28px 24px;
    border: 1px solid var(--border);
    transition: 0.3s;
}

.card:hover {
    border-color: rgba(201, 169, 110, 0.2);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
}

.card .icon {
    font-size: 2.4rem;
    display: block;
    margin-bottom: 12px;
}

.card .price {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: var(--gold);
    margin: 10px 0;
}

/* ===== ФУТЕР ===== */
.footer {
    text-align: center;
    padding: 40px 20px;
    border-top: 1px solid var(--border);
    margin-top: 60px;
}

.footer .brand {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    letter-spacing: 4px;
    color: var(--text-muted);
}

.footer .brand .gold {
    color: var(--gold);
}

.footer .brand .heart {
    color: var(--pink);
}

.footer p {
    font-size: 0.7rem;
    opacity: 0.4;
    margin-top: 8px;
}

/* ===== АДАПТАЦИЯ ===== */
@media (max-width: 700px) {
    .navbar {
        padding: 12px 20px;
        flex-direction: column;
        align-items: flex-start;
    }
    .navbar .nav-links {
        gap: 14px;
    }
    .navbar .nav-links a {
        font-size: 0.7rem;
    }
    h1 {
        font-size: 2rem;
    }
    h2 {
        font-size: 1.4rem;
    }
    .container {
        padding: 40px 16px;
    }
}
